# Copy this file to .env and replace placeholder values for your local machine.

# The public URL of your server deployment (used for OAuth redirect URIs).
# Leave blank for local/desktop use (defaults to http://localhost:PORT).
# Example: https://bulletin.yourchurch.org
APP_URL=

# Planning Center OAuth credentials (for Settings > Connect Planning Center).
# Create an OAuth app at https://api.planningcenteronline.com/oauth/applications
# and add APP_URL/oauth/pco/callback as an authorized redirect URI.
PCO_CLIENT_ID=your-planning-center-client-id
PCO_CLIENT_SECRET=your-planning-center-client-secret

# --- Supabase Auth ---
# Browser-safe values used by src/js/auth-ui.js. The anon key is publishable and
# protected by RLS; it is safe to ship to the browser/Electron client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-side only. Used by auth.py to verify Supabase access tokens received
# as Authorization: Bearer <token>. Get this from Supabase Dashboard ->
# Settings -> API -> JWT Secret. Never expose it to frontend JS or Electron.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Google Calendar & Drive Integration ---
# Used by the /oauth/google/start flow (server.py) for connecting Calendar and Drive.
# Requests calendar+drive scopes only — NOT identity scopes (openid, email, profile).
# Tokens are stored deployment-wide in settings.json (not per-user).
# Create a project at https://console.cloud.google.com, enable the Calendar API,
# and add APP_URL/oauth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: one or more calendar feed URLs.
# You can use a JSON array or a comma/newline-separated list.
CALENDAR_ICAL_URLS=["https://calendar.google.com/calendar/ical/example%40group.calendar.google.com/public/basic.ics"]

# Optional: event titles to suppress from the "This Week" page.
CALENDAR_EXCLUDE_TITLES=["Sunday Morning Worship","Sunday Service","Worship Service"]

# Optional: override the Watchtower HTTP API token used by the "Update Now" button.
# The default ("bulletin-updater") works for most deployments since Watchtower is
# only reachable within the private Docker network, never exposed externally.
# WATCHTOWER_TOKEN=bulletin-updater

# ── Server mode (APP_MODE=server) ─────────────────────────────────────────────
# These variables are required when running in Docker/server mode.
# Desktop users (APP_MODE=desktop) do not need them.

# Full Postgres connection URL. Must point to the postgres service defined in
# docker-compose.yml (or an external managed database).
# Example: postgresql://bulletin:yourpassword@postgres:5432/bulletindb
DATABASE_URL=postgresql://${POSTGRES_USER:-bulletin}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-bulletindb}

# Service-role / admin connection string for RLS-BYPASSING admin work only
# (seed + migration tooling via db.admin_transaction()). SERVER-SIDE ONLY —
# never bundle this into the Electron desktop app, commit a real value, or log
# it. If unset, db.admin_transaction() falls back to DATABASE_URL. For Supabase
# this is the session-pooler URL using the service_role credentials.
# SUPABASE_SERVICE_ROLE_URL=postgresql://postgres.<ref>:<service_role_pw>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase service role JWT — used by storage_assets.py for server-initiated
# Storage uploads (cover/logo images).  This is the HTTP "service_role" key from
# Supabase Dashboard → Settings → API → Project API keys (NOT the Postgres password).
# SERVER-SIDE ONLY — never bundle into the Electron app, commit a real value, or log.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Postgres credentials — used by the postgres service in docker-compose.yml
# and embedded in DATABASE_URL above.
POSTGRES_DB=bulletindb
POSTGRES_USER=bulletin
POSTGRES_PASSWORD=change-me-before-deploying
